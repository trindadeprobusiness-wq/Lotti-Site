# O checkout fica indisponível de forma segura enquanto estas variáveis não existirem.
# Nunca use NEXT_PUBLIC_ para chaves do Asaas ou do Supabase.

ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

SUPABASE_URL=
# Prefira a nova Secret Key (sb_secret_...). A service_role legada também é aceita.
SUPABASE_SECRET_KEY=

# Página da plataforma que recebe o convite e permite criar a senha.
LOTTI_APP_PASSWORD_SETUP_URL=

# Lista separada por vírgulas. Em desenvolvimento, inclua http://localhost:3000.
CHECKOUT_ALLOWED_ORIGINS=http://localhost:3000
